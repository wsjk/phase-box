cmake_minimum_required(VERSION 3.16)
project(hardware_sim LANGUAGES C CXX)

set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CXX_STANDARD_REQUIRED ON)

# Fetch Raylib automatically (zero system install required)
include(FetchContent)
FetchContent_Declare(
    raylib
    URL https://github.com/raysan5/raylib/archive/refs/tags/5.0.tar.gz
)
set(BUILD_EXAMPLES OFF CACHE BOOL "" FORCE)
FetchContent_MakeAvailable(raylib)

add_executable(hardware_sim src/main.cpp)
target_include_directories(hardware_sim PRIVATE include)
target_link_libraries(hardware_sim PRIVATE raylib)

if (APPLE)
    target_link_libraries(hardware_sim PRIVATE "-framework Cocoa" "-framework IOKit" "-framework CoreVideo")
endif()
